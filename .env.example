# Application
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUTO_CREATE_TABLES=true

# MySQL
MYSQL_DATABASE=vidagt
MYSQL_USER=vidagt
MYSQL_PASSWORD=vidagt
MYSQL_ROOT_PASSWORD=change-root-password
DATABASE_URL=mysql+asyncmy://vidagt:vidagt@mysql:3306/vidagt?charset=utf8mb4
# 宿主机访问 MySQL 的端口；容器间连接仍固定使用 3306。
MYSQL_HOST_PORT=3307

# Redis: DB 0 search/checkpoints, DB 1 Celery broker, DB 2 results, DB 3 cache/locks
REDIS_URL=redis://redis:6379/3
REDIS_SEARCH_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=http://minio:9000
# 局域网访问时改为宿主机地址，例如 http://192.168.1.20:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CORS_ALLOW_ORIGIN=http://localhost:5173,http://localhost:8080
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vidagt
PRESIGNED_URL_TTL_SECONDS=900

# Uploads and processing
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=10800
UPLOAD_PART_SIZE=16777216
UPLOAD_PARALLELISM=4
WORK_DIR=/tmp/vidagt
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Local speech recognition
ASR_MODEL_GPU=large-v3-turbo
ASR_MODEL_CPU=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE_GPU=int8_float16
ASR_COMPUTE_TYPE_CPU=int8
MAX_KEYFRAMES=180
MAX_VISION_FRAMES=40

# OpenAI-compatible model provider (SiliconFlow is only the default example)
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
AI_REQUESTS_PER_MINUTE=10
